{
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist"
    },
    "thread-ai-api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "thread-ai-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
